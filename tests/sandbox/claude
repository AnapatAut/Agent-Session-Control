#!/bin/bash
# Fake Claude Code for the sandbox. comm = "claude". Mimics what tmux-claude-restore
# depends on: the home-dir trust prompt (layout captured from Claude Code 2.1.310),
# and ~/.claude/sessions/<pid>.json written once the REPL starts.
log="$HOME/claude-args.log"
echo "$(date +%T) pid=$$ ppid=$PPID cwd=$PWD args=$*" >> "$log"
sid=""; rc=0; prev=""
for a in "$@"; do
	[ "$prev" = --resume ] && sid=$a
	[[ $a == *remoteControlAtStartup*true* ]] && rc=1
	prev=$a
done
[ -n "${FAKE_RC:-}" ] && rc=1
[ -n "$sid" ] || sid=$(cat /proc/sys/kernel/random/uuid)

if [ "$PWD" = "$HOME" ]; then
	sel=0
	draw() {
		clear
		printf '%s\n' "────────────────────────────────────────" " Accessing workspace:" "" " $PWD" "" \
			" Quick safety check: Is this a project you created or one you trust?" ""
		if [ $sel = 0 ]; then printf '%s\n' " ❯ No, exit" "   Yes, I trust this folder"
		else printf '%s\n' "   No, exit" " ❯ Yes, I trust this folder"; fi
		printf '%s\n' "" " Enter to confirm · Esc to cancel"
	}
	draw
	while IFS= read -rsn1 k; do
		if [ "$k" = $'\e' ]; then
			read -rsn2 -t 0.1 k2
			case "$k2" in "[B") sel=1 ;; "[A") sel=0 ;; *) echo "$(date +%T) pid=$$ trust: esc" >> "$log"; exit 1 ;; esac
			draw
		elif [ -z "$k" ]; then
			[ $sel = 1 ] || { echo "$(date +%T) pid=$$ trust: no" >> "$log"; exit 1; }
			echo "$(date +%T) pid=$$ trust: yes" >> "$log"; break
		fi
	done
	clear
fi

tref=""
[ -n "${TMUX_PANE:-}" ] && tref=$(tmux display -p -t "$TMUX_PANE" '#S:#{window_id}.#{pane_id}')
mkdir -p "$HOME/.claude/sessions"
bridge=""; [ $rc = 1 ] && bridge=',"bridgeSessionId":"bridge-'$$'"'
printf '{"pid":%s,"sessionId":"%s","cwd":"%s","kind":"interactive","tmux":"%s"%s}\n' \
	$$ "$sid" "$PWD" "$tref" "$bridge" > "$HOME/.claude/sessions/$$.json"
trap 'rm -f "$HOME/.claude/sessions/$$.json"; exit 0' TERM HUP INT
echo "fake claude $sid rc=$rc in $PWD"
while :; do sleep 1; done
