#!/bin/bash
# Fake Claude Code for tests/asc.sh. It runs itself again through $FAKE_BASH (a copy of bash
# named claude) as argv[0] "claude", so both its comm and tmux's pane_current_command say
# "claude", as for the real one. Like Claude Code 2.1.316:
# writes ~/.claude/sessions/<pid>.json (with procStart = /proc start time) once its REPL is up,
# shows the trust prompt with "No, exit" selected for a folder not trusted yet, exits 143 on
# SIGTERM after removing its session file, and leaves the file behind on SIGKILL.
# $HOME/fake-busy: status "busy"; $HOME/fake-wait: "waiting" (a question or dialog open);
# $HOME/fake-rc: remote control live (bridgeSessionId set). $HOME/fake-quote: first shows a
# transcript that quotes the trust prompt (not as the last lines) and logs any key it gets in 3 s.
# Then a REPL like 2.1.316's: an input box between two rules ("❯" and a no-break space; with
# $HOME/fake-hint a dim placeholder). "/remote-control NAME" turns rc on; "/remote-control"
# while on opens the dialog (Disconnect this session / Show QR code / Continue, Continue
# selected; status "waiting"; Up from the top wraps to the bottom), Up/Down and Enter, Esc
# closes it. Lines entered are logged. A "/word" being typed shows a command menu under the box
# (Enter takes its first entry). Up in an empty prompt brings back the last line entered.
# $HOME/fake-menu-first: another command ranks first in the menu. $HOME/fake-menu-on: a menu
# stays open under the box after a space too. $HOME/fake-slow-dialog: the dialog opens after
# 1.5 s, and the transcript quotes its lines. $HOME/fake-mangle: an x shows before typed text.
# $HOME/fake-two-lines: the prompt has a second line (text after an empty first line).
# Every start is logged to $HOME/claude-args.log.
if [ -n "${FAKE_BASH:-}" ] && [ "${FAKE_EXECED:-}" != 1 ]; then
	FAKE_EXECED=1 exec -a claude "$FAKE_BASH" "$0" "$@"
fi
log="$HOME/claude-args.log"
echo "pid=$$ cwd=$PWD args=$*" >> "$log"
sid=""; name=""; prev=""; rc=""
for a in "$@"; do
	case $prev in --resume|--session-id) sid=$a ;; --name) name=$a ;; --remote-control) rc=session_start ;; esac
	prev=$a
done
[ -n "$sid" ] || sid=$(cat /proc/sys/kernel/random/uuid)
trusted="$HOME/fake-trusted"
if ! grep -qxF "$PWD" "$trusted" 2>/dev/null; then
	sel=0
	draw() {
		clear
		printf '%s\n' " Accessing workspace:" "" " $PWD" "" " Quick safety check: Is this a project you created or one you trust?" ""
		if [ $sel = 0 ]; then printf '%s\n' " ❯ No, exit" "   Yes, I trust this folder"
		else printf '%s\n' "   No, exit" " ❯ Yes, I trust this folder"; fi
		printf '%s\n' "" " Enter to confirm · Esc to cancel"
	}
	draw
	while IFS= read -rsn1 k; do
		if [ "$k" = $'\e' ]; then
			read -rsn2 -t 0.1 k2
			case "$k2" in "[B") sel=1 ;; "[A") sel=0 ;; *) exit 1 ;; esac
			draw
		elif [ -z "$k" ]; then
			[ $sel = 1 ] || { echo "pid=$$ trust: no" >> "$log"; exit 1; }
			echo "$PWD" >> "$trusted"; echo "pid=$$ trust: yes" >> "$log"; break
		fi
	done
	clear
fi
if [ -e "$HOME/fake-quote" ]; then
	printf '%s\n' " > what does this prompt mean? $PWD" " Accessing workspace:" " Quick safety check: Is this a project you created or one you trust?" \
		" ❯ No, exit" " ❯ Yes, I trust this folder" " Enter to confirm · Esc to cancel" "" " It asks whether to trust the folder." " >"
	read -rsn1 -t 3 k && echo "pid=$$ quote: got a key" >> "$log"
fi
st=$(awk '{ sub(/.*\) /, ""); print $20 }' /proc/$$/stat)
f="$HOME/.claude/sessions/$$.json"
mkdir -p "$HOME/.claude/sessions"
buf=""; dialog=0; sel=2; last=""; pend=0; was=""; at=0
write() {
	local status=idle bridge=""; [ -e "$HOME/fake-busy" ] && status=busy; [ -e "$HOME/fake-wait" ] && status=waiting
	[ $dialog = 1 ] && status=waiting
	[ -n "$rc" ] && bridge=',"bridgeSessionId":"'"$rc"'"'
	[ -e "$HOME/fake-rc" ] && bridge=',"bridgeSessionId":"session_fake"'
	[ "$status" != "$was" ] && { was=$status; at=$(now_ms); }  # statusUpdatedAt: when it changed
	bridge+=',"statusUpdatedAt":'$at; [ $status = waiting ] && bridge+=',"waitingFor":"dialog open"'
	printf '{"pid":%s,"sessionId":"%s","cwd":"%s","kind":"interactive","name":"%s","status":"%s","procStart":"%s"%s}\n' \
		$$ "$sid" "$PWD" "$name" "$status" "$st" "$bridge" > "$f.tmp" && mv -f "$f.tmp" "$f"
}
trap 'rm -f "$f"; exit 143' TERM
trap 'rm -f "$f"; exit 0' INT
rule() { printf '─%.0s' $(seq 1 30); printf '%s\n' "${1:+ $1 ─}"; }
draw() {
	clear
	echo "fake claude $sid name=$name in $PWD"
	[ -n "$said" ] && echo "$said"
	if [ $dialog = 1 ]; then
		echo " Remote Control"
		local i=0
		for o in "Disconnect this session" "Show QR code" "Continue"; do
			if [ $i = $sel ]; then echo " ❯ $((i + 1)). $o"; else echo "   $((i + 1)). $o"; fi
			i=$((i + 1))
		done
		echo " Enter to confirm · Esc to cancel"
	else
		rule "${name:-fake}"
		if [ -z "$buf" ] && [ -e "$HOME/fake-hint" ]; then printf '❯\xc2\xa0\e[2mTry "fix lint"\e[0m\n'
		else printf '❯\xc2\xa0%s\n' "$buf"; fi
		[ -e "$HOME/fake-two-lines" ] && echo "  a second line"
		rule
		if [[ $buf == /* && ( $buf != *" "* || -e $HOME/fake-menu-on ) ]]; then
			[ -e "$HOME/fake-menu-first" ] && echo "  /remote-controller   a plugin's command"
			echo "  /remote-control      Connect this session to claude.ai"
			echo "  /resume              Resume a conversation"
		else
			echo "  fake status line"
		fi
	fi
}
now_ms() { local t=${EPOCHREALTIME/./}; echo $((t / 1000)); }
said=""
enter() {
	echo "pid=$$ line: $buf" >> "$log"
	case $buf in
	"/remote-control")
		if [ -z "$rc" ]; then rc=session_live; said="/remote-control is active (no name)"
		elif [ -e "$HOME/fake-slow-dialog" ]; then pend=$(($(now_ms) + 1500)); said="quoted:   ❯ 1. Disconnect this session"
		else dialog=1; sel=2; fi ;;
	"/remote-control "*) if [ -z "$rc" ]; then rc=session_live; said="/remote-control is active · ${buf#/remote-control }"; fi ;;
	*) said="> $buf" ;;
	esac
	last=$buf; buf=""
}
draw
while :; do
	write
	IFS= read -rsn1 -t 0.3 k; r=$?
	if [ $pend != 0 ] && [ "$(now_ms)" -ge $pend ]; then pend=0; dialog=1; sel=2; draw; fi
	[ $r -gt 128 ] && continue        # timeout: write the session file again
	[ $r != 0 ] && [ -z "$k" ] && { sleep 0.3; continue; }  # no terminal input
	if [ "$k" = $'\e' ]; then
		read -rsn2 -t 0.05 k2
		if [ $dialog = 1 ]; then
			case "$k2" in "[A") sel=$(((sel + 2) % 3)) ;; "[B") sel=$(((sel + 1) % 3)) ;; "") dialog=0 ;; esac
		elif [ "$k2" = "[A" ] && [ -z "$buf" ]; then buf=$last
		fi
	elif [ -z "$k" ]; then
		if [ $dialog = 1 ]; then
			[ $sel = 0 ] && { rc=""; said="Remote Control disconnected."; echo "pid=$$ rc: disconnected" >> "$log"; }
			dialog=0
		else
			if [[ $buf == /* && $buf != *" "* && -e $HOME/fake-menu-first ]]; then buf=/remote-controller; fi
			enter
		fi
	elif [ "$k" = $'\x7f' ]; then buf=${buf%?}
	elif [ $dialog = 0 ]; then
		[ -z "$buf" ] && [ -e "$HOME/fake-mangle" ] && buf=x
		buf+=$k
	fi
	draw
done
