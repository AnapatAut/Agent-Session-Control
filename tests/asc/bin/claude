#!/bin/bash
# Fake Claude Code for tests/asc.sh. It runs itself again through $FAKE_BASH (a copy of bash
# named claude) as argv[0] "claude", so both its comm and tmux's pane_current_command say
# "claude", as for the real one. Like Claude Code 2.1.316:
# writes ~/.claude/sessions/<pid>.json (with procStart = /proc start time) once its REPL is up,
# shows the trust prompt with "No, exit" selected for a folder not trusted yet, exits 143 on
# SIGTERM after removing its session file, and leaves the file behind on SIGKILL.
# $HOME/fake-busy: status "busy"; $HOME/fake-wait: "waiting" (a question or dialog open);
# $HOME/fake-rc: remote control live (bridgeSessionId set). $HOME/fake-quote: first shows a
# transcript that quotes the trust prompt (not as the last lines) and logs any key it gets in 3 s.
# Then a REPL like 2.1.316's: an input box between two rules ("❯" and a no-break space; with
# $HOME/fake-hint a dim placeholder). "/remote-control NAME" turns rc on; "/remote-control"
# while on opens the dialog (Disconnect this session / Show QR code / Continue, Continue
# selected; status "waiting"; Up from the top wraps to the bottom), Up/Down and Enter, Esc
# closes it. Lines entered are logged. A "/word" being typed shows a command menu under the box
# (Enter takes its first entry, marked ❯ as 2.1.318 marks it). Up in an empty prompt brings back
# the last line entered. $HOME/fake-menu-above: the menu shows above the box, the status line
# stays under it (2.1.318). $HOME/fake-plugins: lines other plugins draw around the box: above
# it a band that changes on its own and a rule; under it a status line, a band between two rules
# and a line starting with a path. $HOME/fake-menu-unmarked: no entry marked;
# $HOME/fake-menu-one: only one entry. $HOME/fake-menu-first: another command ranks first in the menu. $HOME/fake-menu-slow: the menu
# shows 1 s after the last key (until then the status line), as a claude with many commands. $HOME/fake-menu-on: a menu
# stays open under the box after a space too. $HOME/fake-slow-dialog: the dialog opens after
# 1.5 s, and the transcript quotes its lines. $HOME/fake-mangle: an x shows before typed text.
# $HOME/fake-two-lines: the prompt has a second line (text after an empty first line).
# $HOME/fake-slow-keys: in the dialog, an arrow key redrawn 0.7 s late (a busy host).
# $HOME/fake-peer-name: the session file says nameSource "peer" (a name claude keeps).
# $HOME/fake-no-rename: "/rename NAME" changes nothing. $HOME/fake-task: a command running (a
# child bash). $HOME/fake-trusted: the folders trusted, one a line (a Yes at the prompt adds one).
# ASC_TRACE set: each key read, each frame drawn and each status change, with its time in ms,
# appended to $HOME/fake-trace.log (tests/asc.sh prints its end on a FAIL).
# $HOME/fake-echo-stall, its text "AT SECONDS" or "AT hold": once AT characters are typed, the
# last of them and any after are not drawn for that long (the flag is removed as it starts), or
# while the flag is there (at most 30 s): a busy host. AT 1: nothing drawn yet.
# $HOME/fake-parked-<session id>: a background job id; the session file names it as parkedJobId
# (claude handed its conversation to that job and shows it). $HOME/fake-branch-<session id>: a
# new session id it takes (a branch or a rewind); $HOME/fake-cd-<session id>: a folder it moves
# to (/cd). $HOME/fake-hog: it takes 400 MB at once (the sandbox's real OOM kill; the flag is
# removed first, so a claude started again does not do it too).
# A conversation is taken up only from its transcript (~/.claude/projects/*/<id>.jsonl, written at
# its first message, or at a /rename): --resume of one with none, and --session-id of one that
# has one, say so and exit 1 at once, as Claude Code 2.1.319 does (tried). It looks in every
# folder of ~/.claude/projects, as asctl does; whether Claude Code looks only in its cwd's is not
# known. $HOME/fake-exit-at-once: it exits 3 at once.
# Every start is logged to $HOME/claude-args.log. `claude stop JOB` (a background session) sends
# SIGTERM to the claude whose session file names that jobId, and fails for a job none names
# ($HOME/fake-stop-fails: it fails anyway).
if [ -n "${FAKE_BASH:-}" ] && [ "${FAKE_EXECED:-}" != 1 ]; then
	FAKE_EXECED=1 exec -a claude "$FAKE_BASH" "$0" "$@"
fi
log="$HOME/claude-args.log"
echo "pid=$$ cwd=$PWD args=$*" >> "$log"
if [ "${1:-}" = stop ]; then
	[ -e "$HOME/fake-stop-fails" ] && { echo "Could not reach the daemon" >&2; exit 1; }
	f=$(grep -l "\"jobId\":\"$2\"" "$HOME"/.claude/sessions/*.json 2>/dev/null | head -1)
	[ -n "$f" ] || { echo "No background session $2" >&2; exit 1; }
	p=$(basename "$f" .json); kill -TERM "$p" && rm -f "$f"; echo "Stopped $2"; exit 0
fi
# Its terminal raw while it runs, as Claude Code's: a key reaches it as sent, never echoed or
# edited by the terminal (bash's read sets that only while it reads: a BSpace that came between
# two reads was taken by the terminal's line editing, and lost).
if [ -t 0 ]; then tty_was=$(stty -g); trap 'stty "$tty_was" 2>/dev/null' EXIT; stty -echo -icanon min 1 time 0; fi
sid=""; how=""; name=""; prev=""; rc=""
for a in "$@"; do
	case $prev in --resume|--session-id) sid=$a how=$prev ;; --name) name=$a ;; --remote-control) rc=session_start ;; esac
	prev=$a
done
[ ! -e "$HOME/fake-exit-at-once" ] || { echo "fake: could not start" >&2; exit 3; }
if [ -n "$sid" ]; then
	had=$(compgen -G "$HOME/.claude/projects/*/$sid.jsonl")
	[ "$how" != --resume ] || [ -n "$had" ] || { echo "No conversation found with session ID: $sid" >&2; exit 1; }
	[ "$how" != --session-id ] || [ -z "$had" ] || { echo "Session ID $sid is already in use." >&2; exit 1; }
fi
[ -n "$sid" ] || sid=$(cat /proc/sys/kernel/random/uuid)
src=""; [ -n "$name" ] || { name="${PWD##*/}-1a"; src=',"nameSource":"derived"'; }  # claude makes one up
trusted="$HOME/fake-trusted"
if ! grep -qxF "$PWD" "$trusted" 2>/dev/null; then
	sel=0
	draw() {
		clear
		printf '%s\n' " Accessing workspace:" "" " $PWD" "" " Quick safety check: Is this a project you created or one you trust?" ""
		if [ $sel = 0 ]; then printf '%s\n' " ❯ No, exit" "   Yes, I trust this folder"
		else printf '%s\n' "   No, exit" " ❯ Yes, I trust this folder"; fi
		printf '%s\n' "" " Enter to confirm · Esc to cancel"
	}
	draw
	while IFS= read -rsn1 k; do
		if [ "$k" = $'\e' ]; then
			read -rsn2 -t 0.1 k2
			case "$k2" in "[B") sel=1 ;; "[A") sel=0 ;; *) exit 1 ;; esac
			draw
		elif [ -z "$k" ]; then
			[ $sel = 1 ] || { echo "pid=$$ trust: no" >> "$log"; exit 1; }
			echo "$PWD" >> "$trusted"; echo "pid=$$ trust: yes" >> "$log"; break
		fi
	done
	clear
fi
if [ -e "$HOME/fake-quote" ]; then
	printf '%s\n' " > what does this prompt mean? $PWD" " Accessing workspace:" " Quick safety check: Is this a project you created or one you trust?" \
		" ❯ No, exit" " ❯ Yes, I trust this folder" " Enter to confirm · Esc to cancel" "" " It asks whether to trust the folder." " >"
	read -rsn1 -t 3 k && echo "pid=$$ quote: got a key" >> "$log"
fi
st=$(awk '{ sub(/.*\) /, ""); print $20 }' /proc/$$/stat)
f="$HOME/.claude/sessions/$$.json"
mkdir -p "$HOME/.claude/sessions"
cwd=$PWD; buf=""; dialog=0; sel=2; last=""; pend=0; was=""; at=0; task=""; started=${EPOCHREALTIME/./}; started=$((started / 1000))
write() {
	local status=idle bridge=""; [ -e "$HOME/fake-busy" ] && status=busy; [ -e "$HOME/fake-wait" ] && status=waiting
	[ $dialog = 1 ] && status=waiting
	[ -n "$rc" ] && bridge=',"bridgeSessionId":"'"$rc"'"'
	[ -e "$HOME/fake-rc" ] && bridge=',"bridgeSessionId":"session_fake"'
	bridge+=$src
	[ -e "$HOME/fake-peer-name" ] && bridge+=',"nameSource":"peer"'
	[ -e "$HOME/fake-parked-$sid" ] && bridge+=',"parkedJobId":"'"$(cat "$HOME/fake-parked-$sid")"'"'
	[ -e "$HOME/fake-branch-$sid" ] && { local was=$sid; sid=$(cat "$HOME/fake-branch-$sid"); rm -f "$HOME/fake-branch-$was"; }
	[ -e "$HOME/fake-cd-$sid" ] && cwd=$(cat "$HOME/fake-cd-$sid")
	bridge+=',"startedAt":'$started
	# $HOME/fake-task: a command running, as claude runs one (a child bash sourcing its shell snapshot)
	if [ -e "$HOME/fake-task" ] && [ -z "$task" ]; then
		bash -c "source $HOME/.claude/shell-snapshots/fake.sh 2>/dev/null || true && sleep 120 && pwd >/dev/null" & task=$!
	elif [ ! -e "$HOME/fake-task" ] && [ -n "$task" ]; then kill "$task" 2>/dev/null; task=""; fi
	[ "$status" != "$was" ] && { was=$status; at=$(now_ms); trace "status $status"; }  # statusUpdatedAt: when it changed
	bridge+=',"statusUpdatedAt":'$at; [ $status = waiting ] && bridge+=',"waitingFor":"dialog open"'
	printf '{"pid":%s,"sessionId":"%s","cwd":"%s","kind":"interactive","name":"%s","status":"%s","procStart":"%s"%s}\n' \
		$$ "$sid" "$cwd" "$name" "$status" "$st" "$bridge" > "$f.tmp" && mv -f "$f.tmp" "$f"
}
trap 'rm -f "$f"; [ -z "$task" ] || kill "$task" 2>/dev/null; exit 143' TERM
trap 'rm -f "$f"; exit 0' INT
rule() { printf '─%.0s' $(seq 1 30); printf '%s\n' "${1:+ $1 ─}"; }
menu_lines() {
	local m="  ❯ " o="    "
	[ -e "$HOME/fake-menu-unmarked" ] && m=$o
	[ -e "$HOME/fake-menu-first" ] && { echo "$m/remote-controller   a plugin's command"; m=$o; }
	echo "$m/remote-control      Connect this session to claude.ai"
	[ -e "$HOME/fake-menu-one" ] || echo "$o/resume              Resume a conversation"
}
draw() {
	clear
	echo "fake claude $sid name=$name in $PWD"
	[ -n "$said" ] && echo "$said"
	if [ $dialog = 1 ]; then
		echo " Remote Control"
		local i=0
		for o in "Disconnect this session" "Show QR code" "Continue"; do
			if [ $i = $sel ]; then echo " ❯ $((i + 1)). $o"; else echo "   $((i + 1)). $o"; fi
			i=$((i + 1))
		done
		echo " Enter to confirm · Esc to cancel"
	else
		local open=0 above=0
		[[ $buf == /* && ( $buf != *" "* || -e $HOME/fake-menu-on ) ]] && [ "$menu_at" = 0 ] && open=1
		[ -e "$HOME/fake-menu-above" ] && above=1
		[ $open = 1 ] && [ $above = 1 ] && menu_lines
		[ -e "$HOME/fake-plugins" ] && { echo "● band $(now_ms)"; rule plugin; echo "  ◆ goal: a plugin's line"; }
		rule "${name:-fake}"
		if [ -z "$buf" ] && [ -e "$HOME/fake-hint" ]; then printf '❯\xc2\xa0\e[2mTry "fix lint"\e[0m\n'
		else printf '❯\xc2\xa0%s\n' "$buf"; fi
		[ -e "$HOME/fake-two-lines" ] && echo "  a second line"
		rule
		if [ $open = 1 ] && [ $above = 0 ]; then menu_lines
		else
			if [ -z "$buf" ]; then echo "  fake status line · ← 1 agent"; else echo "  fake status line"; fi  # as claude: it drops "← 1 agent" while text is typed
		fi
		[ -e "$HOME/fake-plugins" ] && { echo "  [ Model ] [ Ctx 29% ]"; rule; echo "  a plugin's band"; rule; echo "  /srv/x/proj  main"; }
	fi
}
stall() {
	local at n i
	read -r at n < "$HOME/fake-echo-stall" && [ "${#buf}" = "$at" ] || return 0
	if [ "$n" = hold ]; then for ((i = 0; i < 300; i++)); do [ -e "$HOME/fake-echo-stall" ] || break; sleep 0.1; done
	else rm -f "$HOME/fake-echo-stall"; sleep "$n"; fi
}
now_ms() { local t=${EPOCHREALTIME/./}; echo $((t / 1000)); }
trace() { [ -z "${ASC_TRACE-}" ] || printf '%s %s %s\n' "$(now_ms)" "$$" "$*" >> "$HOME/fake-trace.log"; }
menu_at=0
said=""
enter() {
	echo "pid=$$ line: $buf" >> "$log"
	case $buf in
	"/remote-control")
		if [ -z "$rc" ]; then rc=session_live; said="/remote-control is active (no name)"
		elif [ -e "$HOME/fake-slow-dialog" ]; then pend=$(($(now_ms) + 1500)); said="quoted:   ❯ 1. Disconnect this session"
		else dialog=1; sel=2; fi ;;
	"/rename "*) [ -e "$HOME/fake-no-rename" ] || { name=${buf#/rename }; src=""; said="Session renamed to: $name"
		mkdir -p "$HOME/.claude/projects/-fake"  # claude records its answer in the transcript
		printf '{"type":"system","subtype":"local_command","content":"<local-command-stdout>%s</local-command-stdout>"}\n' "$said" >> "$HOME/.claude/projects/-fake/$sid.jsonl"; } ;;
	"/remote-control "*) if [ -z "$rc" ]; then rc=session_live; said="/remote-control is active · ${buf#/remote-control }"; fi ;;
	*) said="> $buf" ;;
	esac
	last=$buf; buf=""
}
draw
while :; do
	write
	if [ -e "$HOME/fake-hog" ]; then rm -f "$HOME/fake-hog"; hog=$(head -c 400000000 /dev/zero | tr '\0' x); fi
	IFS= read -rsN1 -t 0.3 k; r=$?
	if [ $pend != 0 ] && [ "$(now_ms)" -ge $pend ]; then pend=0; dialog=1; sel=2; draw; fi
	if [ $menu_at != 0 ] && [ "$(now_ms)" -ge $menu_at ]; then menu_at=0; draw; fi
	# nothing read: a timeout (write the session file again) or no terminal input. A key is kept,
	# even one read as the read timed out (in k then); read -N: Enter is a character of its own,
	# never an empty read that a timeout could be taken for
	if [ -z "$k" ]; then [ $r -gt 128 ] || sleep 0.3; continue; fi
	case $k in $'\r' | $'\n') k='' ;; esac  # Enter
	trace "key $(printf %q "$k")"
	if [ "$k" = $'\e' ]; then
		read -rsn2 -t 0.05 k2
		if [ $dialog = 1 ]; then
			case "$k2" in "[A") sel=$(((sel + 2) % 3)) ;; "[B") sel=$(((sel + 1) % 3)) ;; "") dialog=0 ;; esac
			[ -n "$k2" ] && [ -e "$HOME/fake-slow-keys" ] && sleep 0.7
		elif [ "$k2" = "[A" ] && [ -z "$buf" ]; then buf=$last
		fi
	elif [ -z "$k" ]; then
		if [ $dialog = 1 ]; then
			[ $sel = 0 ] && { rc=""; said="Remote Control disconnected."; echo "pid=$$ rc: disconnected" >> "$log"; }
			dialog=0
		else
			if [[ $buf == /* && $buf != *" "* && -e $HOME/fake-menu-first ]]; then buf=/remote-controller; fi
			enter
		fi
	elif [ "$k" = $'\x7f' ]; then buf=${buf%?}
	elif [ $dialog = 0 ]; then
		[ -z "$buf" ] && [ -e "$HOME/fake-mangle" ] && buf=x
		buf+=$k
		[ -e "$HOME/fake-echo-stall" ] && stall
	fi
	[ -e "$HOME/fake-menu-slow" ] && [ $dialog = 0 ] && [ -n "$k" ] && menu_at=$(($(now_ms) + 1000))
	draw
	trace "drawn dialog=$dialog sel=$sel buf=$(printf %q "$buf")"
done
