# Generic privacy rules for tools/privacy-check.sh: one Perl regex per line, matched
# anywhere in a line. They hold no real names: those go in <git dir>/privacy-local.
# Write each rule so that its own text does not match it (this file is checked too).

# Home folders other than the test containers' users (/home/$u in scripts is fine).
# @TESTUSERS@ is filled in by the checker: every `mkuser NAME` in tests/ and every
# `useradd … NAME` in tests/sandbox/Dockerfile.
/home/(?!(?:@TESTUSERS@)(?:/|\b)|\$|\{)[A-Za-z0-9_][A-Za-z0-9._-]*
/Users/(?!Shared\b)[A-Za-z0-9_][A-Za-z0-9._-]*
# The same in the folder names Claude Code makes from a path under ~/.claude/projects/ (each
# slash turned into a dash).
(?<![A-Za-z0-9-])-home-(?!(?:@TESTUSERS@)-)[A-Za-z0-9_]

# Links to and ids of claude.ai sessions; the session trailer git commits can carry.
claude\.ai/(?:code|chat|share)\b
\bsession_0[0-9A-Za-z]{8,}
Claude-Session[:]

# A UUID, except a test one made of one digit (77777777-7777-4777-8777-777777777777).
\b(?!([0-9a-f])\1{7}-)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b

# Any email, except GitHub noreply ones, git@github.com and Anthropic's noreply.
(?<![A-Za-z0-9._%+-])(?![0-9]+\+[A-Za-z0-9-]+@users\.noreply\.github\.com\b|git@github\.com\b|noreply@anthropic\.com\b)[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}\b

# Tailscale: MagicDNS names, tailnet addresses (100.64/10, the CGNAT range), auth keys.
\.ts\.net\b
\b100\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b
\btskey-[A-Za-z0-9-]{10,}

# Credentials.
\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}
\bgithub_pat_[A-Za-z0-9_]{20,}
\bsk-ant-[A-Za-z0-9_-]{10,}
\bAKIA[0-9A-Z]{16}\b
-----BEGIN (?:[A-Z]+ )*PRIVATE KEY-----
discord(?:app)?\.com/api/webhooks/
hooks\.slack\.com/services/
\bxox[abpr]-[A-Za-z0-9-]{10,}
